# Missing pages get Yuki and the rope
ErrorDocument 404 /error/404.html

# The new pages need nothing inline, so they get a strict policy. The old demos
# elsewhere on the site keep the server's looser one.
<If "%{REQUEST_URI} =~ m#^/(index\.html|portfolio/(nl/)?(index\.html)?)?$#">
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</If>

# Caching: code and text are always revalidated (a cheap 304 when unchanged), so a
# new demo.js is never stuck behind an old one; media may be kept for a day.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css|txt|xml|toml)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(ogg|m4a|ttf|png|svg|jpg|ico)$">
        Header set Cache-Control "max-age=86400"
    </FilesMatch>
</IfModule>

# Old side documents that now live elsewhere
Redirect 301 /media/qtpass.pdf https://qtpass.org/

# One canonical host: send www.annejan.com, and any other name that lands here,
# to annejan.com (but leave certificate challenges alone)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} !^annejan\.com(:\d+)?$ [NC]
    RewriteRule ^(.*)$ https://annejan.com/$1 [R=301,L]
</IfModule>

<FilesMatch "^mail$">
    ForceType application/x-httpd-php
</FilesMatch>
<FilesMatch "^test$">
    ForceType application/x-httpd-php
</FilesMatch>
<FilesMatch "security.qr$">
    ForceType image/svg+xml
</FilesMatch>

