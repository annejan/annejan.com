    <script type="text/javascript">                                         
        $(document).ready(function(){

	$('.social a').click(function(){
            $(this).addClass('hoverIn hoverOut');
            $(this).children().css('z-index', '1').animate({width:2048, height: 2048, left: -1024, top: -1024, opacity: 0}, 1000, function(){
              window.location = $(this).parent().attr('href');
              $(this).parent().removeClass('hoverIn hoverOut');
            });
            $('body').animate({backgroundColor: '#ffffff'}, 2000);
            $('.social').animate({opacity: 0}, 2000);
            $('h3').animate({opacity: 0}, 2000);
            return false;
          }).hover(function(){
            if (!$(this).is('.hoverIn')) {
              $(this).addClass('hoverIn').children().css('z-index', '1').animate({width: 128, height: 128, left: -32, top: -32, opacity: 0.8}, 200, function(){
                $(this).parent().removeClass('hoverIn');
              });
            }
          }, function(){
          if (!$(this).is('.hoverOut')) {
            $(this).addClass('hoverOut').children().animate({width: 64, height: 64, left: 0, top: 0, opacity: 1}, 200, function(){
              $(this).css('z-index', '0').parent().removeClass('hoverOut');
            });
          }
        });
	$('#home').click(function(){
            $('body').animate({opacity: 0}, 1000, function(){
		window.location = '/';
	    });
	    return false;
	});
    });
    </script>     
